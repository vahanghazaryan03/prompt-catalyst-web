import React from 'react';
import { motion } from 'framer-motion';
import { PlayCircle, Loader2, LockIcon } from 'lucide-react';
import { Tooltip } from './Tooltip';

const AnimateButton = ({ 
  onClick, 
  isGenerating, 
  disabled, 
  creditCost = 0, 
  duration = '3',
  isPremiumRequired = false,
  onPremiumClick = null
}) => {
  // Get duration multiplier to calculate total credits
  const getDurationMultiplier = () => {
    switch(duration) {
      case '2': return 0.8;
      case '5': return 1.5;
      default: return 1.0; // 3 seconds is the base
    }
  };

  // Calculate total credit cost with duration multiplier
  const totalCost = Math.round(creditCost * getDurationMultiplier());
  
  // Different tooltip messages based on button state
  const getTooltipContent = () => {
    if (isPremiumRequired) {
      return "Premium subscription required for this feature";
    }
    
    if (disabled && creditCost > 0) {
      return "Missing required selections or not enough credits";
    }
    
    return `This will cost ${totalCost} credits`;
  };

  return (
    <motion.button
      whileHover={!disabled ? { scale: 1.02 } : {}}
      whileTap={!disabled ? { scale: 0.98 } : {}}
      onClick={isPremiumRequired ? onPremiumClick : onClick}
      disabled={isPremiumRequired ? false : (isGenerating || disabled)}
      className={`w-full flex items-center justify-center gap-3 px-4 py-3 rounded-lg 
        ${isPremiumRequired 
          ? 'bg-gradient-to-r from-amber-500 to-amber-600 text-black hover:from-amber-400 hover:to-amber-500' 
          : 'bg-[var(--primary)] text-black hover:brightness-110'
        } 
        font-medium shadow-sm hover:shadow-md transition-all duration-200
        ${(disabled && !isPremiumRequired) ? 'opacity-50 cursor-not-allowed' : ''}
      `}
    >
      {isGenerating ? (
        <>
          <Loader2 size={20} className="animate-spin" />
          <span>Generating...</span>
        </>
      ) : isPremiumRequired ? (
        <>
          <LockIcon size={18} className="shrink-0" />
          <span className="flex-1">Upgrade to Premium</span>
        </>
      ) : (
        <>
          <PlayCircle size={20} className="shrink-0" />
          <span className="flex-1">Generate Animation</span>
          {creditCost > 0 && (
            <Tooltip content={getTooltipContent()}>
              <span className="text-sm opacity-80 bg-black/10 px-2 py-0.5 rounded flex items-center gap-1 cursor-help">
                {totalCost} Credits
              </span>
            </Tooltip>
          )}
        </>
      )}
    </motion.button>
  );
};

export default AnimateButton;