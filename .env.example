# Optional. Overrides the Google OAuth client id compiled into the app, which is
# useful when running against your own Google project. A client id is public by
# design — it identifies the application, it does not authorise anything.
REACT_APP_GOOGLE_CLIENT_ID=

# The API is served from the same origin under /api, so there is no base URL to
# configure. Nothing else in this app needs a secret: the Supabase key it ships
# with is the anon key, which is meant to reach the browser.
